[Unit]
Description=Lumo bar (status bar wayland client)
# Aguarda WAYLAND_DISPLAY via lumo-wm ou socket disponivel.
# Sem After=lumo-wm pois lumo-wm pode nao rodar via systemd.
After=graphical-session-pre.target

[Service]
Type=simple
# Espera WAYLAND_DISPLAY estar disponivel antes de exec.
ExecStartPre=/bin/bash -c 'until [ -n "${WAYLAND_DISPLAY}" ] && [ -S "${XDG_RUNTIME_DIR}/${WAYLAND_DISPLAY}" ]; do sleep 0.05; done'
ExecStart=%h/Projects/lumo-shell/target/release/lumo-bar
Restart=on-failure
RestartSec=1
StandardOutput=journal
StandardError=journal
# Env de sessao Wayland (herdado de loginctl/PAM).
PassEnvironment=WAYLAND_DISPLAY XDG_RUNTIME_DIR HOME XDG_CONFIG_HOME DISPLAY

[Install]
WantedBy=default.target

[Unit]
Description=Lumo Bridge -- HTTP daemon de controle remoto Lumo OS para agentes LLM
After=graphical-session-pre.target

[Service]
Type=simple
Environment=WAYLAND_DISPLAY=wayland-1
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStart=%h/Projects/lumo-shell/target/release/lumo-bridge
Restart=on-failure
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target

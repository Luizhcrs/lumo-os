[Unit]
Description=Lumo OSD (Caps Lock / Volume / Brightness overlay)
After=graphical-session-pre.target

[Service]
Type=simple
ExecStartPre=/bin/bash -c 'until [ -n "${WAYLAND_DISPLAY}" ] && [ -S "${XDG_RUNTIME_DIR}/${WAYLAND_DISPLAY}" ]; do sleep 0.05; done'
ExecStart=%h/Projects/lumo-shell/target/release/lumo-osd
Restart=on-failure
RestartSec=1
StandardOutput=journal
StandardError=journal
PassEnvironment=WAYLAND_DISPLAY XDG_RUNTIME_DIR HOME XDG_CONFIG_HOME DISPLAY

[Install]
WantedBy=default.target

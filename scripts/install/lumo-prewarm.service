[Unit]
Description=Lumo OS pre-warm: wallpaper decode + cache em /dev/shm
# Roda antes do compositor. Nao bloqueia boot se falhar.
DefaultDependencies=no
After=basic.target

[Service]
Type=oneshot
# RemainAfterExit=yes pra systemd reconhecer como "active" pos-execucao.
RemainAfterExit=yes
# User obrigatorio: service de sistema roda como root por padrao, e %h
# resolveria /root (script vive na home do user). Sem isso o boot mostra
# "Failed at step EXEC ... /root/Projects/...: No such file or directory".
User=luizhcrds
Group=luizhcrds
# Path absoluto: %h em system unit resolve /root mesmo com User= (gotcha
# systemd — %h = home do manager=root, nao do User=). Hardcode pra home
# do user dono do repo. Bug boot: status 203/EXEC em /root/Projects/...
ExecStart=/home/luizhcrds/Projects/lumo-shell/scripts/install/lumo-prewarm.sh
# Nao falhar a sessao se wallpaper nao existe.
SuccessExitStatus=0 1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target

# Lumo OS: grupo video pode escrever brightness intel_backlight.
#
# Usa GROUP=/MODE= nativo do udev em vez de RUN+="/usr/bin/chgrp ...":
# o device backlight aparece no early boot (initramfs) onde /usr ainda
# nao esta montado, entao o callout /usr/bin/chgrp falha com
# "Failed to find and pin callout binary". Assignment nativo nao depende
# de binario externo e funciona em qualquer fase do boot.
ACTION=="add", SUBSYSTEM=="backlight", KERNEL=="intel_backlight", GROUP="video", MODE="0664"

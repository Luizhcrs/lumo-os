{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 0,
    "modules-left": ["custom/lumo"],
    "modules-center": ["hyprland/window"],
    "modules-right": ["backlight", "network", "battery", "clock"],

    "custom/lumo": {
        "format": " Lumo",
        "tooltip": false,
        "on-click": "rofi -show drun -theme ~/.config/rofi/lumo.rasi"
    },

    "hyprland/window": {
        "format": "{title}",
        "max-length": 80,
        "separate-outputs": true
    },

    "battery": {
        "states": { "warning": 30, "critical": 15 },
        "format": "{capacity}%",
        "format-charging": "{capacity}% +",
        "on-click": "~/.config/waybar/scripts/battery-panel.sh"
    },

    "network": {
        "format-wifi": "{signalStrength}%",
        "format-ethernet": "ETH",
        "format-disconnected": "off",
        "on-click": "~/.config/waybar/scripts/wifi-menu.sh",
        "tooltip-format": "{essid} ({signalStrength}%)\n{ifname}: {ipaddr}"
    },

    "backlight": {
        "format": "{percent}%",
        "on-scroll-up": "brightnessctl s 5%+",
        "on-scroll-down": "brightnessctl s 5%-",
        "on-click": "~/.config/waybar/scripts/brightness-panel.sh"
    },

    "clock": {
        "format": "{:%a %d %b %H:%M}",
        "tooltip": false,
        "on-click": "swaync-client -t -sw"
    }
}

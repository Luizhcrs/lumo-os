// Lumo OS - rofi dropdown theme (Mac-style menu bar dropdowns).
// Bat/wifi/brightness/clock click handlers usam este theme.

* {
    bg: #1A1A1Cee;
    bg-alt: #28282C;
    fg: #F5F5F7;
    fg-dim: rgba(245, 245, 247, 0.5);
    accent: #00C896;
    border: rgba(255, 255, 255, 0.08);
    radius: 12px;

    background-color: transparent;
    text-color: @fg;
    font: "Inter 13";
}

window {
    transparency: "real";
    background-color: @bg;
    border: 1px solid;
    border-color: @border;
    border-radius: @radius;
    width: 280px;
    padding: 0;
    location: north east;
    anchor: north east;
    x-offset: -14px;
    y-offset: 42px;
}

mainbox {
    children: [ inputbar, listview ];
    padding: 0;
}

inputbar {
    background-color: transparent;
    children: [ prompt, entry ];
    padding: 10px 14px;
    border: 0 0 1px 0;
    border-color: @border;
    spacing: 8px;
}

prompt {
    background-color: transparent;
    text-color: @accent;
    font: "Inter Bold 13";
}

entry {
    background-color: transparent;
    placeholder-color: @fg-dim;
}

listview {
    background-color: transparent;
    columns: 1;
    lines: 8;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    padding: 6px;
    spacing: 1px;
}

element {
    background-color: transparent;
    text-color: @fg;
    padding: 7px 12px;
    border-radius: 8px;
    children: [ element-text ];
}

element selected {
    background-color: @accent;
    text-color: white;
}

element-text {
    text-color: inherit;
    background-color: transparent;
    vertical-align: 0.5;
}
